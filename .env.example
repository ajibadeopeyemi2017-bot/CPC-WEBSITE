# ==============================================================
# Christ The Potter Church (CPC) - Environment Configuration
# ==============================================================

# 1. Resend Email Service (https://resend.com)
# Sign up for a free account at https://resend.com and create an API Key.
# Paste your API key here:
RESEND_API_KEY=

# 2. Recipient Email Address
# The church inbox where all visitor RSVPs, prayer requests, and volunteer applications are sent:
NOTIFICATION_RECIPIENT_EMAIL=christthepotterchurch@gmail.com

# 3. From Email Address
# With a free Resend testing account, you can use: onboarding@resend.dev
# Once a domain (e.g. christthepotterchurch.org) is verified in Resend, you can use: no-reply@yourdomain.org
NOTIFICATION_FROM_EMAIL=Christ The Potter Church <onboarding@resend.dev>

# 4. Paystack Payment Gateway (https://paystack.com)
# Create a free account at https://dashboard.paystack.com/#/signup
# Go to Settings -> API Keys & Webhooks:
# Paste your Public Key (starts with pk_test_... or pk_live_...):
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
# Paste your Secret Key (starts with sk_test_... or sk_live_...):
PAYSTACK_SECRET_KEY=

# 5. Pastoral & Administrative Portal Passcode
# Access the admin dashboard at /admin:
ADMIN_PASSCODE=cpc2026admin

# 6. Database & Cloud Persistence (Recommended for Vercel / Production)
# If left blank, the app runs in resilient local file / serverless /tmp mode.
#
# Option A: Upstash Redis / Vercel KV (Fastest serverless KV - https://upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# (Or Vercel KV credentials if deploying directly on Vercel):
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Option B: Supabase (PostgreSQL - https://supabase.com)
# Create a free Supabase project, go to Project Settings -> API:
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
